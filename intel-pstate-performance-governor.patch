+/* In active intel_pstate mode, the performance algorithm owns EPP and
+ * rejects attempts to write a less performance-oriented preference. Switch
+ * back to powersave before applying any non-performance EPP value. */
+static gboolean
+set_epp_governor (PpdDriverIntelPstate *pstate,
+                  const char           *governor,
+                  GError              **error)
+{
+  guint i;
+
+  for (i = 0; pstate->epp_devices && i < pstate->epp_devices->len; i++) {
+    const char *epp_path = g_ptr_array_index (pstate->epp_devices, i);
+    g_autofree char *policy_dir = g_path_get_dirname (epp_path);
+    g_autofree char *gov_path = g_build_filename (policy_dir, "scaling_governor", NULL);
+
+    if (!ppd_utils_write (gov_path, governor, error))
+      return FALSE;
+  }
+
+  return TRUE;
+}
